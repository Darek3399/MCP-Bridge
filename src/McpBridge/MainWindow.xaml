<Window x:Class="McpBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MCP Bridge" Height="860" Width="1360" MinHeight="640" MinWidth="980" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="8" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
        </Style>

        <Style x:Key="EyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#68707A"/>
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        

        

        <Style x:Key="HelpIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#AAB4BE"/>
            <Setter Property="Background" Value="#202329"/>
            <Setter Property="BorderBrush" Value="#46505B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Help"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HelpBorder" Width="20" Height="20" CornerRadius="10"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HelpBorder" Property="BorderBrush" Value="#2CE5D0"/>
                                <Setter TargetName="HelpBorder" Property="Background" Value="#253A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusPillStyle" TargetType="Border">
            <Setter Property="Background" Value="#192B2B"/>
            <Setter Property="BorderBrush" Value="#2CE5D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="9,4"/>
        </Style>

        <Style x:Key="McpTableCellToolTipStyle" TargetType="{x:Type ToolTip}">
            <Setter Property="Background" Value="#171B20"/>
            <Setter Property="BorderBrush" Value="#46505B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="#EAECEF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="480"
                                   Foreground="#EAECEF" FontFamily="Segoe UI" FontSize="11"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToolTip}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarTitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F2F5F8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Static Brushes.Transparent}">
                    <Setter Property="Foreground" Value="#969FA8"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarSubtitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#2CE5D0"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Static Brushes.Transparent}">
                    <Setter Property="Foreground" Value="#586069"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarVectorIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#2CE5D0"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Static Brushes.Transparent}">
                    <Setter Property="Stroke" Value="#6E7781"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarIconBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#192B2B"/>
            <Setter Property="BorderBrush" Value="#2CE5D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Button}}" Value="{x:Static Brushes.Transparent}">
                    <Setter Property="Background" Value="#181A1E"/>
                    <Setter Property="BorderBrush" Value="#292D33"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#111315" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ТОП-БАР -->
            <Border Grid.Row="0" Background="{StaticResource TopBarBrush}" BorderBrush="#141619" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ЧИСТЫЙ ЗНАЧОК >< БЕЗ ФОНА И ОБВОДКИ (1 В 1 КАК СЛЕВА ВНИЗУ) -->
                    <Border Grid.Column="0" BorderBrush="#15171A" BorderThickness="0,0,1,0" Padding="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 2,4 L 8,10 L 2,16 M 18,4 L 12,10 L 18,16"
                                  Stroke="#2CE5D0" StrokeThickness="1.8" Width="18" Height="16" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock VerticalAlignment="Center" FontSize="19">
                                <Run Text="mcp" Foreground="#B8C0C8" FontWeight="Light"/><Run Text="Bridge" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#15171A" BorderThickness="0,0,1,0" Padding="20,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TopStatusLabelText" Text="СТАТУС:" FontSize="10" FontWeight="Bold" Foreground="#586069" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="FooterStatusText" Text="Готово" FontSize="12" Foreground="#969FA8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#15171A" BorderThickness="0,0,1,0" Padding="18,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle x:Name="RuntimeStatusDot" Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="#2CE5D0" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="RuntimeStatusText" Text="Запуск мониторинга…" FontSize="11.5" FontWeight="SemiBold" Foreground="#EAECEF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" Click="Minimize_Click">
                            <Path Data="M 0,0 L 10,0" Stroke="#8C949E" StrokeThickness="1.3"/>
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeButtonStyle}" Click="Maximize_Click">
                            <Rectangle Width="9" Height="9" Stroke="#8C949E" StrokeThickness="1.2"/>
                        </Button>
                        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource ChromeCloseButtonStyle}" Click="Close_Click">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#8C949E" StrokeThickness="1.3"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- БОКОВАЯ ПАНЕЛЬ -->
                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#141619" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Button x:Name="NavDashboardButton" Style="{StaticResource SidebarButtonStyle}" Click="NavDashboard_Click" BorderBrush="#2CE5D0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconBoxStyle}">
                                        <Path Style="{StaticResource SidebarVectorIconStyle}" Data="M 3,3 L 10,3 L 10,10 L 3,10 Z M 14,3 L 21,3 L 21,10 L 14,10 Z M 3,14 L 10,14 L 10,21 L 3,21 Z M 14,14 L 21,14 L 21,21 L 14,21 Z"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="NavDashTitleText" Text="Главная" Style="{StaticResource SidebarTitleTextStyle}"/>
                                        <TextBlock x:Name="NavDashSubText" Text="Сводка и статус" Style="{StaticResource SidebarSubtitleTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="NavServicesButton" Style="{StaticResource SidebarButtonStyle}" Click="NavServices_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconBoxStyle}">
                                        <Path Style="{StaticResource SidebarVectorIconStyle}" Data="M 3,4 L 21,4 L 21,9 L 3,9 Z M 3,15 L 21,15 L 21,20 L 3,20 Z M 7,6.5 L 7.1,6.5 M 7,17.5 L 7.1,17.5 M 12,9 L 12,15"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="NavSrvTitleText" Text="MCP-сервисы" Style="{StaticResource SidebarTitleTextStyle}"/>
                                        <TextBlock x:Name="NavSrvSubText" Text="Оркестратор и пулы" Style="{StaticResource SidebarSubtitleTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="NavLogsButton" Style="{StaticResource SidebarButtonStyle}" Click="NavLogs_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconBoxStyle}">
                                        <Path Style="{StaticResource SidebarVectorIconStyle}" Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 8,9 L 11,12 L 8,15 M 13,15 L 16,15"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="NavLogsTitleText" Text="Логи" Style="{StaticResource SidebarTitleTextStyle}"/>
                                        <TextBlock x:Name="NavLogsSubText" Text="Подключения и система" Style="{StaticResource SidebarSubtitleTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="NavSettingsButton" Style="{StaticResource SidebarButtonStyle}" Click="NavSettings_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SidebarIconBoxStyle}">
                                        <Path Style="{StaticResource SidebarVectorIconStyle}" Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18 M 9,4 L 9,8 M 15,10 L 15,14 M 11,16 L 11,20"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="NavSetTitleText" Text="Настройки" Style="{StaticResource SidebarTitleTextStyle}"/>
                                        <TextBlock x:Name="NavSetSubText" Text="Технические и UI/UX" Style="{StaticResource SidebarSubtitleTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                        </StackPanel>

                        <!-- НИЖНЯЯ ПАНЕЛЬ: БИЛД И ССЫЛКА НА GITHUB -->
                        <Border Grid.Row="1" VerticalAlignment="Bottom" 
                                BorderBrush="#141619" BorderThickness="0,1,0,0" 
                                Background="#1A1C20" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="AppVersionText" 
                                               Text="v0.9.0" 
                                               FontSize="10.5" 
                                               FontFamily="Segoe UI, Consolas" 
                                               Foreground="#545B64" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Click="GitHubButton_Click" 
                                        Cursor="Hand" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        Padding="4"
                                        AutomationProperties.Name="Open MCP Bridge GitHub repository"
                                        ToolTipService.IsEnabled="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path Width="16" Height="16" 
                                          Stretch="Uniform" 
                                          Fill="#6E7781"
                                          Data="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                        <Setter Property="Fill" Value="#2CE5D0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- РАБОЧАЯ ОБЛАСТЬ -->
                <Grid Grid.Column="1" Margin="24,20,24,20">
                    <TabControl x:Name="MainPages" BorderThickness="0" Background="Transparent" SelectedIndex="0">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid><ContentPresenter ContentSource="SelectedContent"/></Grid>
                            </ControlTemplate>
                        </TabControl.Template>

                        <!-- ВКЛАДКА 0: ГЛАВНАЯ -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <primitives:UniformGrid Columns="3" Margin="0,0,0,16">
                                        <Border x:Name="Kpi1CardBorder" Style="{StaticResource KpiCardBorderStyle}" Margin="0,0,12,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource KpiCircleBadgeStyle}">
                                                    <Path x:Name="Kpi1StatusIconPath" Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18" Stroke="#2CE5D0" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Kpi1TitleText" Text="Активные сервисы" FontSize="11" Foreground="#7A828C" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="DashboardServiceCount" Text="0 / 0" FontSize="23" FontWeight="Light" Foreground="#F2F5F8" HorizontalAlignment="Right" Margin="0,2,0,1"/>
                                                    <TextBlock x:Name="Kpi1SubText" Text="Динамический шлюз" FontSize="10" Foreground="#586069" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="Kpi2CardBorder" Style="{StaticResource KpiCardBorderStyle}" Margin="0,0,12,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource KpiCircleBadgeStyle}">
                                                    <Path x:Name="Kpi2StatusIconPath" Data="M 12,2 L 19,5 L 19,11 C 19,16.5 15.8,20.6 12,22 C 8.2,20.6 5,16.5 5,11 L 5,5 Z" Stroke="#2CE5D0" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Kpi2TitleText" Text="Local MCP Bridge" FontSize="11" Foreground="#7A828C" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="DashboardGatewayPort" Text="http://127.0.0.1:8004/mcp" FontSize="12" FontFamily="Consolas" Foreground="#F2F5F8" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Margin="0,5,0,4"/>
                                                    <TextBlock x:Name="Kpi2SubText" Text="Local endpoint" FontSize="10" Foreground="#586069" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border x:Name="Kpi3CardBorder" Style="{StaticResource KpiCardBorderStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource KpiCircleBadgeStyle}">
                                                    <Path x:Name="Kpi3StatusIconPath" Data="M 10,14 L 14,10 M 7,17 L 5,19 C 3.5,17.5 3.5,15 5,13.5 L 8,10.5 M 17,7 L 19,5 C 20.5,6.5 20.5,9 19,10.5 L 16,13.5" Stroke="#2CE5D0" StrokeThickness="1.7" Width="16" Height="16" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Kpi3TitleText" Text="Онлайн-подключение" FontSize="11" Foreground="#7A828C" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="DashboardPublicUrlState" Text="Не активен" FontSize="16" FontWeight="Light" Foreground="#F2F5F8" HorizontalAlignment="Right" Margin="0,3,0,2"/>
                                                    <TextBlock x:Name="Kpi3SubText" Text="Tailscale Funnel" FontSize="10" Foreground="#2CE5D0" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                    </primitives:UniformGrid>

                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DashServicesTitleText" Text="Состояние MCP-сервисов" Style="{StaticResource SectionTitleStyle}"/>
                                                    <TextBlock Text="  |  " FontSize="14" Foreground="#444B54" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="DashServicesSubText" Text="Текущий статус подключений" FontSize="12.5" Foreground="#7A828C" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button x:Name="DashManageBtn" Grid.Column="1" Content="Управление серверами →" Click="NavServices_Click" Padding="12,5" FontSize="11" Visibility="Collapsed"/>
                                            </Grid>

                                            <Border Background="#1A1D21" BorderBrush="#2A2E35" BorderThickness="1" Padding="16,9" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="DashColServiceText" Text="СЕРВИС" Style="{StaticResource EyebrowStyle}"/>
                                                    <TextBlock x:Name="DashColStatusText" Grid.Column="1" Text="СТАТУС" Style="{StaticResource EyebrowStyle}"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl x:Name="DashboardServicesListControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#1A1D21" BorderThickness="0,0,0,1" Padding="16,12">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" Foreground="#F2F5F8"/>
                                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="2" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding DisplayStatusText}" Foreground="{Binding BadgeForeground}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Grid Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="DashUeTitleText" Text="Unreal Editor" Style="{StaticResource SectionTitleStyle}"/>
                                                        <TextBlock Text="  |  " FontSize="14" Foreground="#444B54" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="DashUeSubText" Text="Обнаруженные сессии" FontSize="12.5" Foreground="#7A828C" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button x:Name="DashFoldersBtn" Grid.Column="1" Content="Разрешённые папки →" Click="NavSettings_Click" Padding="10,4" FontSize="11"/>
                                                </Grid>

                                                <TextBlock x:Name="DashUeProcLabel" Text="ПРОЦЕСС РЕДАКТОРА" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,6"/>
                                                <Border Background="#181A1E" BorderBrush="#2A2E35" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                                                    <TextBlock x:Name="EditorProcessText" Text="Не подключён" FontFamily="Consolas" FontSize="12" Foreground="#EAECEF" TextWrapping="Wrap"/>
                                                </Border>

                                                <TextBlock x:Name="DashUeProjLabel" Text="ПУТЬ ПРОЕКТА (.UPROJECT)" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,6"/>
                                                <Border Background="#181A1E" BorderBrush="#2CE5D0" BorderThickness="2,0,0,0" Padding="12,10">
                                                    <TextBlock x:Name="EditorProjectText" Text="Новые запуски будут обнаружены автоматически." FontFamily="Consolas" FontSize="11.5" Foreground="#B0B8C0" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,14">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="DashTunnelCardTitleText" Text="Внешнее подключение" Style="{StaticResource SectionTitleStyle}"/>
                                                        <TextBlock Text="  |  " FontSize="14" Foreground="#444B54" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="DashTunnelCardSubText" Text="Tailscale Funnel" FontSize="12.5" Foreground="#7A828C" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock x:Name="DashTunnelStateLabel" Text="СОСТОЯНИЕ ТУННЕЛЯ" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,6"/>
                                                <Border x:Name="TailscaleStatusBorder" Background="#332714" BorderBrush="#D89B3B" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                                                    <TextBlock x:Name="TailscaleStatusText" Text="ТОЛЬКО ЛОКАЛЬНО · Онлайн-доступ не настроен. Локальная работа доступна." FontSize="12" Foreground="#FFC66D" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </Border>

                                                <TextBlock x:Name="DashTunnelUrlLabel" Text="АДРЕС ПОДКЛЮЧЕНИЯ (URL)" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#16191D" BorderBrush="#2CE5D0" BorderThickness="0,0,0,2" Padding="12,10">
                                                        <TextBlock x:Name="DashboardUrlText" Text="Ожидание подключения" FontFamily="Consolas" Foreground="#2CE5D0" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <Button x:Name="DashCopyUrlBtn" Grid.Column="2" Content="Копировать" Style="{StaticResource PrimaryButtonStyle}" Click="CopyUrl_Click" Padding="14,9"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ВКЛАДКА 1: MCP-СЕРВИСЫ -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="PresetsTitleText" Text="Пресеты наборов серверов" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="PresetsSubText" Text="Быстрое переключение профилей в 1 клик. Крестик справа от пресета удаляет его." Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"/>

                                                <ItemsControl x:Name="PresetsItemsControl" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#1B1E22" BorderBrush="#2F343C" BorderThickness="1" CornerRadius="2" Margin="0,0,8,6">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Content="{Binding DisplayName}" Click="PresetButton_Click" Tag="{Binding Id}" BorderThickness="0" Background="Transparent" Padding="12,6"/>
                                                                    <Button Content="✕" Click="DeletePreset_Click" Tag="{Binding Id}" BorderThickness="1,0,0,0" BorderBrush="#2A2E35" Background="Transparent" Foreground="#7F8790" Padding="8,6" FontSize="10.5"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                                <Button x:Name="SavePresetBtn" Content="＋ Сохранить пресет" Click="SavePreset_Click" Margin="0,0,8,0" Padding="12,7,12,9"/>
                                                <Button x:Name="AddServerBtn" Content="＋ Добавить сервер" Click="AddCustomServer_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="14,7,14,9"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel Grid.IsSharedSizeScope="True">
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="SrvTableTitleText" Text="Управление MCP-серверами и техническая сводка" Style="{StaticResource SectionTitleStyle}"/>
                                                    <TextBlock x:Name="SrvTableSubText" Text="Включайте, редактируйте или удаляйте серверы. Выключенные STDIO-процессы полностью останавливаются." Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <Border Background="#1A1D21" BorderBrush="#2A2E35" BorderThickness="1" Padding="14,9" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="42"/>
                                                        <ColumnDefinition Width="2.6*"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="76"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="SrvColOnText" Text="ВКЛ" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="SrvColNameText" Grid.Column="1" Text="СЕРВИС И НАЗНАЧЕНИЕ" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" Margin="10,0,14,0"/>
                                                    <TextBlock x:Name="SrvColPortText" Grid.Column="2" Text="ПОРТ / ПУТЬ" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <TextBlock x:Name="SrvColStatusText" Grid.Column="3" Text="СТАТУС" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <TextBlock x:Name="SrvColToolsText" Grid.Column="4" Text="ИНСТРУМЕНТЫ" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <TextBlock x:Name="SrvColActionsText" Grid.Column="5" Text="ДЕЙСТВИЯ" Style="{StaticResource EyebrowStyle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <ItemsControl x:Name="ServersManagerListControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#1A1D21" BorderThickness="0,0,0,1" Padding="14,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="42"/>
                                                                    <ColumnDefinition Width="2.6*"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                    <ColumnDefinition Width="105"/>
                                                                    <ColumnDefinition Width="76"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="ServerToggle_Click" Tag="{Binding Id}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,14,0">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.InitialShowDelay="350"
                                                                                   ToolTipOpening="TrimmedTextBlock_ToolTipOpening" Tag="{Binding Name}">
                                                                            <TextBlock.ToolTip>
                                                                                <ToolTip Style="{StaticResource McpTableCellToolTipStyle}" Content="{Binding Name}"/>
                                                                            </TextBlock.ToolTip>
                                                                        </TextBlock>
                                                                        <Border Grid.Column="1" Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{Binding BadgeForeground}"/>
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"
                                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.InitialShowDelay="350"
                                                                               ToolTipOpening="TrimmedTextBlock_ToolTipOpening" Tag="{Binding Subtitle}">
                                                                        <TextBlock.ToolTip>
                                                                            <ToolTip Style="{StaticResource McpTableCellToolTipStyle}" Content="{Binding Subtitle}"/>
                                                                        </TextBlock.ToolTip>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                                                    <TextBlock Text="{Binding EndpointDisplay}" FontFamily="Consolas" FontSize="12.5" FontWeight="SemiBold"
                                                                               Foreground="#EAECEF" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.InitialShowDelay="350"
                                                                               ToolTipOpening="TrimmedTextBlock_ToolTipOpening" Tag="{Binding EndpointDisplay}">
                                                                        <TextBlock.ToolTip>
                                                                            <ToolTip Style="{StaticResource McpTableCellToolTipStyle}" Content="{Binding EndpointDisplay}"/>
                                                                        </TextBlock.ToolTip>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding PathDisplay}" FontFamily="Consolas" FontSize="10" Foreground="#626A73"
                                                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.InitialShowDelay="350"
                                                                               ToolTipOpening="TrimmedTextBlock_ToolTipOpening" Tag="{Binding PathDisplay}">
                                                                        <TextBlock.ToolTip>
                                                                            <ToolTip Style="{StaticResource McpTableCellToolTipStyle}" Content="{Binding PathDisplay}"/>
                                                                        </TextBlock.ToolTip>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="3" Text="{Binding DisplayStatusText}" FontSize="11.5"
                                                                           Foreground="{Binding BadgeForeground}" VerticalAlignment="Center"
                                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"
                                                                           ToolTipService.InitialShowDelay="350"
                                                                           ToolTipOpening="TrimmedTextBlock_ToolTipOpening" Tag="{Binding DisplayStatusText}">
                                                                    <TextBlock.ToolTip>
                                                                        <ToolTip Style="{StaticResource McpTableCellToolTipStyle}" Content="{Binding DisplayStatusText}"/>
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>

                                                                <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,14,0">
                                                                    <Border Background="#16191D" BorderBrush="#2C3138" BorderThickness="1" CornerRadius="2" Padding="9,4" Visibility="{Binding ToolsBadgeVisibility}">
                                                                        <TextBlock Text="{Binding ToolsBadgeText}" FontFamily="Consolas" FontSize="13.5" FontWeight="SemiBold" Foreground="#2CE5D0"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                    <Button Content="✎" ToolTip="Править / Edit" Click="EditServer_Click" Tag="{Binding Id}" Width="30" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                                                                    <Button ToolTip="Удалить / Delete" Click="DeleteServer_Click" Tag="{Binding Id}" Visibility="{Binding DeleteButtonVisibility}" Width="30" Height="28" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="#7F8790" StrokeThickness="1.5" Width="10" Height="10" Stretch="Fill" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ВКЛАДКА 2: ЛОГИ -->
                        <TabItem>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource KpiCardBorderStyle}" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource KpiCircleBadgeStyle}" Margin="0,0,14,0">
                                            <Path Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 8,9 L 11,12 L 8,15 M 13,15 L 16,15" Stroke="#2CE5D0" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="LogsHeaderTitleText" Text="Журнал подключений и MCP (Logs\connections.log)" FontSize="15" FontWeight="SemiBold"/>
                                            <CheckBox x:Name="LoggingEnabledCheckBox" Content="Запись логов включена" Margin="0,8,0,0" Click="LoggingEnabled_Click"/>
                                            <TextBlock x:Name="LoggingEnabledHintText" Text="По умолчанию выключено. Включение/выключение действует сразу." Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button x:Name="LogTabConnectionsButton" Content="Подключения и MCP" Click="LogCategoryConnections_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" Margin="0,0,8,0"/>
                                                <Button x:Name="LogTabAppButton" Content="Приложение" Click="LogCategoryApp_Click" Padding="12,5" Margin="0,0,8,0"/>
                                                <Button x:Name="LogTabErrorsButton" Content="Ошибки (errors.log)" Click="LogCategoryErrors_Click" Padding="12,5" Margin="0,0,8,0"/>
                                                <Button x:Name="LogTabVerificationButton" Content="Верификация" Click="LogCategoryVerification_Click" Padding="10,5" Margin="0,0,8,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="ClearLogsBtn" Content="Очистить" Click="ClearLogs_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="RefreshLogsBtn" Content="Обновить" Click="RefreshLogs_Click" Margin="0,0,8,0"/>
                                            <Button x:Name="OpenLogsFolderBtn" Content="Открыть папку Logs" Style="{StaticResource PrimaryButtonStyle}" Click="OpenLogsFolder_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="2">
                                    <TextBox x:Name="LogsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="11.5" Foreground="#D6DCE2" Background="#16181B" BorderThickness="0" Padding="14,12"/>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ВКЛАДКА 3: НАСТРОЙКИ (РАЗДЕЛЕНЫ НА ТЕХНИЧЕСКИЕ И UI/UX) -->
                        <TabItem>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="208"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="SettingsNavigationTitleText" Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#68707A" Margin="12,2,0,10"/>
                                        <Button x:Name="TechnicalSettingsNavButton" Style="{StaticResource SidebarButtonStyle}" Click="TechnicalSettingsNav_Click" BorderBrush="#2CE5D0">
                                            <TextBlock x:Name="TechnicalSettingsNavText" Text="Технические настройки и подключения" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2F5F8"/>
                                        </Button>
                                        <Button x:Name="InterfaceSettingsNavButton" Style="{StaticResource SidebarButtonStyle}" Click="InterfaceSettingsNav_Click">
                                            <TextBlock x:Name="InterfaceSettingsNavText" Text="Интерфейс и приложение" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold" Foreground="#969FA8"/>
                                        </Button>
                                        <Button x:Name="ComponentsSettingsNavButton" Style="{StaticResource SidebarButtonStyle}" Click="ComponentsSettingsNav_Click">
                                            <TextBlock x:Name="ComponentsSettingsNavText" Text="Компоненты" TextWrapping="Wrap" FontSize="12.5" FontWeight="SemiBold" Foreground="#969FA8"/>
                                        </Button>
                                    </StackPanel>

                                    <!-- ТЕХНИЧЕСКИЕ НАСТРОЙКИ И ПОДКЛЮЧЕНИЯ -->
                                    <StackPanel x:Name="TechnicalSettingsPanel" Grid.Column="2">
                                        <!-- 1. Папки файловой системы (с переименованным именем ФС) -->
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="6"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="12"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="RootsSectionTitleText" Text="Разрешённые папки (Filesystem MCP)" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                                    <Button x:Name="RenameFsBtn" Grid.Column="1" Content="✎ Переименовать" Click="RenameFilesystem_Click" Padding="10,4" FontSize="11"/>
                                                </Grid>

                                                <TextBlock x:Name="RootsSectionSubText" Grid.Row="2"
                                                           Text="Отмеченные галочкой папки доступны для чтения и записи. Снятие галочки мгновенно отключает доступ к папке без перезапуска роутера."
                                                           Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>

                                                <ListBox x:Name="RootsListBox" Grid.Row="4" MinHeight="190" MaxHeight="250" SelectionMode="Single">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Padding="10,8" Margin="2" Background="#202429" BorderBrush="#2C3138" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="RootToggle_Click" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{Binding PathForeground}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="10" Foreground="{Binding StatusForeground}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>

                                                <Grid Grid.Row="6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Button x:Name="AddRootBtn" Grid.Column="0" Content="＋  Добавить папку" Click="AddRoot_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                                                    <Button x:Name="RemoveRootBtn" Grid.Column="2" Content="Удалить выбранную" Click="RemoveRoot_Click"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- 2. Tailscale device connection -->
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TunnelSettingsTitleText" Text="Tailscale" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                                    <Button x:Name="TailscaleCheckButton" Grid.Column="1" Content="Подключить" Click="TailscaleCheck_Click"
                                                            Style="{StaticResource PrimaryButtonStyle}" Padding="12,5" FontSize="11" Margin="0,0,8,0"/>
                                                    <Button x:Name="TailscaleHelpButton" Grid.Column="2" Content="?" Style="{StaticResource HelpIconButtonStyle}"
                                                            ToolTipService.InitialShowDelay="300" ToolTipService.ShowDuration="30000">
                                                        <Button.ToolTip>
                                                            <ToolTip Background="Transparent" BorderThickness="0" Padding="0"
                                                                     Placement="Left" HorizontalOffset="-8" HasDropShadow="True">
                                                                <Border Width="340" MinHeight="280" Background="#171B20"
                                                                        BorderBrush="#46505B" BorderThickness="1"
                                                                        CornerRadius="10" Padding="18">
                                                                    <StackPanel>
                                                                        <TextBlock x:Name="TailscaleHelpTitleText" Text="ОНЛАЙН-ДОСТУП ЧЕРЕЗ TAILSCALE"
                                                                                   FontSize="12" FontWeight="Bold"
                                                                                   Foreground="#2CE5D0" Margin="0,0,0,12"/>
                                                                        <TextBlock x:Name="TailscaleHelpIntroText" Text="Подключение необязательно. Без него MCP Bridge продолжает работать локально — Unreal MCP и локальные сервисы не зависят от Funnel."
                                                                                   FontSize="11" Foreground="#EAECEF" TextWrapping="Wrap"
                                                                                   LineHeight="17" Margin="0,0,0,12"/>
                                                                        <TextBlock x:Name="TailscaleHelpStep1Text" Text="1. Нажмите «Подключить». Bridge откроет приложение Tailscale. Войдите в аккаунт и подключите устройство кнопкой Connect."
                                                                                   FontSize="11" Foreground="#D4DAE0" TextWrapping="Wrap"
                                                                                   LineHeight="17" Margin="0,0,0,10"/>
                                                                        <TextBlock x:Name="TailscaleHelpStep2Text" Text="2. Если потребуется, подтвердите устройство в Admin Console → Machines. Затем разрешите Funnel в открывшемся окне браузера."
                                                                                   FontSize="11" Foreground="#D4DAE0" TextWrapping="Wrap"
                                                                                   LineHeight="17" Margin="0,0,0,10"/>
                                                                        <TextBlock x:Name="TailscaleHelpStep3Text" Text="3. Bridge дождётся подтверждений и сам запустит публичный HTTPS endpoint. Нажимать «Подключить» между этапами не нужно."
                                                                                   FontSize="11" Foreground="#D4DAE0" TextWrapping="Wrap"
                                                                                   LineHeight="17" Margin="0,0,0,12"/>
                                                                        <Border Background="#28251F" BorderBrush="#8C6A32" BorderThickness="1"
                                                                                CornerRadius="6" Padding="10">
                                                                            <TextBlock x:Name="TailscaleHelpWarnText" Text="Важно: публичный URL доступен всем, кто его знает. Ограничьте разрешённые Filesystem roots только нужными папками."
                                                                                       FontSize="10.5" Foreground="#FFC66D" TextWrapping="Wrap"
                                                                                       LineHeight="16"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </Grid>
                                                <TextBlock x:Name="TunnelSettingsSubText" Text="Tailscale уже установлен вместе с MCP Bridge, но не запускается и не подключается автоматически. Пока онлайн-доступ не настроен, все локальные функции продолжают работать. MCP Bridge не изменяет системный DNS." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                <Border x:Name="TailscaleAuthStatusBorder" Background="#181A1E" BorderBrush="#2A2E35" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TailscaleAuthStateEyebrowText" Text="РЕЖИМ РАБОТЫ" Style="{StaticResource EyebrowStyle}"/>
                                                        <TextBlock x:Name="TailscaleAuthStatusText" Text="ТОЛЬКО ЛОКАЛЬНО · Онлайн-доступ ещё не настроен. MCP Bridge работает в обычном режиме." FontSize="11" Foreground="#FFC66D" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Border>


                                            </StackPanel>
                                        </Border>

                                        <!-- 3. Public endpoint via Tailscale Funnel -->
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="PublicEndpointTitleText" Text="Адреса подключения" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="PublicEndpointSubText" Text="Локальный и публичный адреса Bridge MCP." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                <TextBlock x:Name="LocalUrlEyebrowText" Text="ЛОКАЛЬНЫЙ URL" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,6"/>
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="LocalMcpUrlTextBox" Text="http://127.0.0.1:8004/mcp" IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                                    <Button x:Name="CopyLocalUrlButton" Grid.Column="2" Content="Копировать URL" Click="CopyLocalUrl_Click" ToolTipService.InitialShowDelay="350"/>
                                                </Grid>

                                                <TextBlock x:Name="TunnelUrlEyebrowText" Text="ПУБЛИЧНЫЙ URL" Style="{StaticResource EyebrowStyle}" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="McpUrlTextBox" Text="Funnel не запущен" IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                                                    <Button x:Name="CopyUrlButton" Grid.Column="2" Content="Копировать URL" IsEnabled="False" Click="CopyUrl_Click"
                                                            ToolTip="Копирует URL активного Funnel, не меняя его состояние."
                                                            ToolTipService.InitialShowDelay="350"/>
                                                </Grid>

                                                <TextBlock x:Name="UrlHintText" Text="После публикации здесь появится публичный URL Funnel." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>

                                    <!-- ИНТЕРФЕЙС И ПРИЛОЖЕНИЕ -->
                                    <StackPanel x:Name="InterfaceSettingsPanel" Grid.Column="2" Visibility="Collapsed">

                                        <!-- 1. Смена языка (RU / EN) -->
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock x:Name="LangCardTitleText" Text="Язык интерфейса / Language" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="LangCardSubText" Text="Переключение языка интерфейса в реальном времени без перезапуска приложения." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="LangRuButton" Content="Русский (RU)" Click="LangRu_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="0,0,10,0"/>
                                                    <Button x:Name="LangEnButton" Content="English (EN)" Click="LangEn_Click" Padding="16,8"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. Плавный масштаб интерфейса -->
                                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="ScaleCardTitleText" Text="Масштаб интерфейса" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="FontScaleValueText" Grid.Column="1" Text="100%" Foreground="#2CE5D0" FontFamily="Consolas" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button x:Name="ResetScaleBtn" Grid.Column="3" Content="100%" Click="ResetScale_Click" Padding="8,3" FontSize="10.5"/>
                                                </Grid>
                                                <TextBlock x:Name="ScaleCardSubText" Text="Плавная регулировка размера текста и элементов во всём окне (85% — 135%)." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                <Slider x:Name="FontScaleSlider" Minimum="0.85" Maximum="1.35" Value="1.0" TickFrequency="0.01" IsSnapToTickEnabled="False" IsMoveToPointEnabled="True" VerticalAlignment="Center" ValueChanged="FontScaleSlider_ValueChanged" PreviewMouseLeftButtonUp="FontScaleSlider_Commit" KeyUp="FontScaleSlider_CommitKeyUp"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. Автозапуск и системный трей -->
                                        <Border Style="{StaticResource CardBorderStyle}">
                                            <StackPanel>
                                                <TextBlock x:Name="BgCardTitleText" Text="Автозапуск и работа в фоне" Style="{StaticResource SectionTitleStyle}"/>
                                                <CheckBox x:Name="AutoStartCheckBox" Content="Запускать MCP Bridge вместе с Windows" Margin="0,12,0,8" Click="AutoStart_Click"/>
                                                <TextBlock x:Name="BgCardSubText" Text="Закрытие окна на крестик сворачивает приложение в системный трей. Для полного выхода используйте меню трея." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- КОМПОНЕНТЫ: ПОДРАЗДЕЛ НАСТРОЕК -->
                                    <StackPanel x:Name="DependencySettingsPanel" Grid.Column="2" Visibility="Collapsed" MinHeight="650">
                                        <ContentControl x:Name="DependencyStatusHost" MinHeight="620"/>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
