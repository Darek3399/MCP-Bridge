<Application x:Class="McpBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- ПАЛИТРА BATTERX: МАТОВЫЙ ГРАФИТ + НЕОНОВЫЙ ЦИАН -->
        <Color x:Key="WindowBackgroundColor">#181A1D</Color>
        <Color x:Key="SidebarColor">#1E2125</Color>
        <Color x:Key="TopBarColor">#202328</Color>
        <Color x:Key="PanelBackgroundColor">#22252A</Color>
        <Color x:Key="PanelRaisedColor">#282C32</Color>
        <Color x:Key="PanelInsetColor">#181A1E</Color>
        <Color x:Key="PanelBorderColor">#2C3036</Color>
        <Color x:Key="StructuralDividerColor">#141619</Color>
        <Color x:Key="TextPrimaryColor">#EAECEF</Color>
        <Color x:Key="TextSecondaryColor">#7F8790</Color>
        <Color x:Key="TextMutedColor">#545B64</Color>
        <Color x:Key="AccentColor">#2CE5D0</Color>
        <Color x:Key="AccentTealColor">#2CE5D0</Color>
        <Color x:Key="AccentPurpleColor">#2CE5D0</Color>

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
        <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
        <SolidColorBrush x:Key="TopBarBrush" Color="{StaticResource TopBarColor}" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}" />
        <SolidColorBrush x:Key="PanelInsetBrush" Color="{StaticResource PanelInsetColor}" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
        <SolidColorBrush x:Key="StructuralDividerBrush" Color="{StaticResource StructuralDividerColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentTealBrush" Color="{StaticResource AccentTealColor}" />
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
        
        <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="#FF6B78" />
        <SolidColorBrush x:Key="StatusDisconnectedBorderBrush" Color="#FF5A67" />
        <SolidColorBrush x:Key="StatusDisconnectedBackgroundBrush" Color="#381B20" />
        <SolidColorBrush x:Key="StatusConnectingBrush" Color="#F5A623" />
        <SolidColorBrush x:Key="StatusConnectingBackgroundBrush" Color="#332915" />
        <SolidColorBrush x:Key="StatusConnectedBrush" Color="#2CE5D0" />
        <SolidColorBrush x:Key="StatusConnectedBackgroundBrush" Color="#15322F" />
        <SolidColorBrush x:Key="StatusDisabledBrush" Color="#7F8790" />
        <SolidColorBrush x:Key="StatusDisabledBorderBrush" Color="#3A4049" />

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1F3836" Offset="0" />
            <GradientStop Color="#172B2A" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#24282E" Offset="0" />
            <GradientStop Color="#202328" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="KpiCardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#25292F" Offset="0" />
            <GradientStop Color="#202429" Offset="0.82" />
            <GradientStop Color="#1D2E2E" Offset="1" />
        </LinearGradientBrush>

        <!-- КНОПКИ ОКНА (СВЕРНУТЬ / РАЗВЕРНУТЬ / ЗАКРЫТЬ) -->
        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#7F8790"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#282C32"/>
                                <Setter Property="Foreground" Value="#EAECEF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#181A1D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeButtonBorder" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#C42B3A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeButtonBorder" Property="Background" Value="#9A202C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ТОНКИЙ ГРАФИТОВЫЙ СКРОЛЛБАР -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="#16181B"/>
            <Setter Property="Foreground" Value="#2E333B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#16181B" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton" Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#2E333B" BorderBrush="#3A404A" BorderThickness="1" CornerRadius="4"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#2CE5D0"/>
                                                        <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#2CE5D0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton" Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                <Setter TargetName="DecreaseButton" Property="Command" Value="{x:Static ScrollBar.LineLeftCommand}"/>
                                <Setter TargetName="IncreaseButton" Property="Command" Value="{x:Static ScrollBar.LineRightCommand}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- БАЗОВАЯ ТИПОГРАФИКА -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- КНОПКИ -->
        <Style TargetType="Button">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="#D6DCE2" />
            <Setter Property="Background" Value="#1B1E22" />
            <Setter Property="BorderBrush" Value="#2F343C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#262A30" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2CE5D0" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- АКЦЕНТНАЯ КНОПКА -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}" />
            <Setter Property="BorderBrush" Value="#2CE5D0" />
            <Setter Property="Foreground" Value="#2CE5D0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- КНОПКА БОКОВОГО МЕНЮ (ГРАФИТ + БИРЮЗОВАЯ ПОЛОСА СПРАВА У АКТИВНОЙ ВКЛАДКИ) -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{x:Static Brushes.Transparent}" />
            <Setter Property="Foreground" Value="#8A929A" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="NavBorder"
                                    Background="#272B31"
                                    BorderBrush="#15171A"
                                    BorderThickness="0,0,0,1">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ActiveIndicator"
                                    Width="3"
                                    HorizontalAlignment="Right"
                                    Background="#2CE5D0"
                                    Visibility="Visible" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="BorderBrush" Value="{x:Static Brushes.Transparent}">
                                <Setter TargetName="NavBorder" Property="Background" Value="#1E2125" />
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="BorderBrush" Value="{x:Static Brushes.Transparent}" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavBorder" Property="Background" Value="#23272C" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#2A2F36" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- КАРТОЧКИ И МОДУЛИ -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelGradient}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

        <!-- KPI-КАРТОЧКА С НИЖНЕЙ БИРЮЗОВОЙ ЛИНИЕЙ 2PX -->
        <Style x:Key="KpiCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource KpiCardGradient}" />
            <Setter Property="BorderBrush" Value="#2CE5D0" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!-- КРУГЛЫЙ МЕДАЛЬОН ИКОНКИ СЛЕВА НА KPI-КАРТОЧКАХ -->
        <Style x:Key="KpiCircleBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="#181B1F" />
            <Setter Property="BorderBrush" Value="#2D3239" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ПОЛЯ ВВОДА И СПИСКИ -->
        <Style TargetType="TextBox">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#181A1E" />
            <Setter Property="BorderBrush" Value="#2C3036" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#181A1E" />
            <Setter Property="BorderBrush" Value="#2C3036" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
        </Style>

        <!-- КАСТОМНЫЙ СЛАЙДЕР -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="#16181B" BorderBrush="#2C3036" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#2CE5D0" Stroke="#181A1D" StrokeThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- КАСТОМНЫЙ ЧЕКБОКС -->
        <Style TargetType="CheckBox">
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Border x:Name="CheckBoxBorder"
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="#181A1E"
                                        BorderBrush="#343942"
                                        BorderThickness="1"
                                        CornerRadius="2"/>
                                <Path x:Name="CheckMark"
                                      Width="14"
                                      Height="14"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Data="M 3,9 L 7,13 L 14,5"
                                      Stroke="#2CE5D0"
                                      StrokeThickness="2"
                                      Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2CE5D0" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBorder" Property="Background" Value="#192D2C" />
                                <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#2CE5D0" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>