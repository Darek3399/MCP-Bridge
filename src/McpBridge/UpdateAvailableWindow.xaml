<Window x:Class="McpBridge.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MCP Bridge"
        Width="490"
        Height="258"
        MinWidth="490"
        MinHeight="258"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowOuterBorder" Background="{StaticResource WindowBackgroundBrush}" BorderBrush="#111315" BorderThickness="1">
        <Grid x:Name="WindowRootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Фирменная верхняя панель MCP Bridge -->
            <Border Grid.Row="0"
                    Background="{StaticResource TopBarBrush}"
                    BorderBrush="#141619"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="18,0,0,0">
                        <Path Data="M 2,4 L 8,10 L 2,16 M 18,4 L 12,10 L 18,16"
                              Stroke="#2CE5D0"
                              StrokeThickness="1.8"
                              Width="18"
                              Height="16"
                              Stretch="Uniform"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="16" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Auto">
                            <Run Text="mcp" Foreground="#B8C0C8" FontWeight="Light"/>
                            <Run Text="Bridge" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource ChromeCloseButtonStyle}"
                            Width="46"
                            Height="45"
                            Click="Close_Click">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="#8C949E"
                              StrokeThickness="1.3"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="26,21,26,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="DialogHeadingText"
                           Grid.Row="0"
                           Text="ДОСТУПНО ОБНОВЛЕНИЕ"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#2CE5D0"/>

                <TextBlock x:Name="DialogVersionText"
                           Grid.Row="1"
                           Text="MCP Bridge v0.0.0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#EAECEF"
                           Margin="0,7,0,0"/>

                <StackPanel Grid.Row="2" Margin="0,9,0,0">
                    <TextBlock x:Name="DialogMessageText"
                               Text="Обновление загружено и проверено. Установить его сейчас?"
                               FontSize="12"
                               Foreground="#AAB2BA"
                               TextWrapping="Wrap"
                               LineHeight="19"/>
                    <Border Background="#192B2B"
                            BorderBrush="#28514D"
                            BorderThickness="1"
                            CornerRadius="2"
                            Padding="10,7"
                            Margin="0,13,0,0">
                        <TextBlock x:Name="VerifiedStatusText"
                                   Text="УСТАНОВЩИК ЗАГРУЖЕН И ПРОВЕРЕН"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="#2CE5D0"/>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,17,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="LaterButton"
                            Grid.Column="0"
                            MinWidth="112"
                            Padding="16,9"
                            HorizontalAlignment="Right"
                            Content="Позже"
                            Click="Later_Click"/>

                    <Button x:Name="InstallButton"
                            Grid.Column="2"
                            MinWidth="130"
                            Padding="18,9"
                            Content="Установить"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Install_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
