# Local workspace: developer-only scripts, builds, diagnostics and temporary data.
/Work/
/GitHub-Repository/

# IDE and editor state.
/.idea/
**/.idea/
/.vs/
**/.vs/
/.vscode/
**/.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Build output and package caches.
[Bb]in/
[Oo]bj/
node_modules/
**/node_modules/
/Dependencies/*
!/Dependencies/README.md

# Temporary files and caches.
*.tmp
*.bak
*.backup
*.swp
*~
Thumbs.db
Desktop.ini

# Local application state, logs and private configuration.
Config/
Logs/
*.log
settings.json
tailscale-state.txt
installer-language.txt
router-upstreams.json
filesystem-gateway.json
composite-gateway.json

# Runtime dependencies are never committed. Keep the explanatory README only.
installer/Payload/*
!installer/Payload/README.md

# Release installers and third-party installers are distributed separately.
*.msi
MCPBridge-Setup-*.exe
